{
  "name": "asterfold",
  "version": "3.2.2",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "description": "A local-first visual bookmark workspace for Chrome New Tab.",
  "scripts": {
    "dev": "wxt",
    "prepare": "wxt prepare",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:store": "node scripts/validate-store-assets.mjs",
    "release": "npm run validate:version && npm run scan:source && npm run build && REQUIRE_GENERATED_MANIFEST=true npm run validate:version && npm run validate:store && node scripts/release.mjs",
    "release:repro": "npm run validate:version && npm run scan:source && npm run build && REQUIRE_GENERATED_MANIFEST=true npm run validate:version && npm run validate:store && node scripts/verify-release.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "clean": "node scripts/clean.mjs",
    "validate:version": "node scripts/validate-version.mjs",
    "validate:package": "node scripts/validate-release-package.mjs",
    "validate:provenance": "node scripts/verify-provenance.mjs",
    "scan:source": "node scripts/scan-source.mjs",
    "audit:development": "npm audit --json > npm-audit.json || true && node scripts/check-audit-baseline.mjs npm-audit.json && rm -f npm-audit.json",
    "test:upgrade": "playwright test e2e/upgrade.spec.ts",
    "test:stress": "vitest run tests/performanceStress.test.ts && playwright test e2e/performance.spec.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "dexie": "4.4.4",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "0.545.0",
    "minisearch": "7.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/chrome": "0.1.31",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.1.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.4",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "wxt": "0.21.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "fx-runner": "1.5.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "nanoid": "git+https://github.com/ai/nanoid.git#73d67168136b36fd3b644159b0cff149da4905d9"
  }
}
