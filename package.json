{
  "name": "asterfold",
  "version": "3.9.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "description": "A local-first visual bookmark workspace for Chrome New Tab.",
  "scripts": {
    "dev": "wxt",
    "prepare": "wxt prepare",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:store": "node scripts/validate-store-assets.mjs",
    "release": "npm run validate:version && npm run scan:source && npm run build && REQUIRE_GENERATED_MANIFEST=true npm run validate:version && npm run validate:store && node scripts/release.mjs",
    "release:repro": "npm run validate:version && npm run scan:source && npm run build && REQUIRE_GENERATED_MANIFEST=true npm run validate:version && npm run validate:store && node scripts/verify-release.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "clean": "node scripts/clean.mjs",
    "validate:version": "node scripts/validate-version.mjs",
    "validate:package": "node scripts/validate-release-package.mjs",
    "validate:provenance": "node scripts/verify-provenance.mjs",
    "validate:sbom": "node scripts/generate-sbom.mjs && node scripts/validate-sbom.mjs",
    "scan:source": "node scripts/scan-source.mjs",
    "audit:development": "npm audit --json > npm-audit.json || true && node scripts/check-audit-baseline.mjs npm-audit.json && rm -f npm-audit.json",
    "test:upgrade": "playwright test e2e/upgrade.spec.ts",
    "test:stress": "vitest run tests/performanceStress.test.ts && playwright test e2e/performance.spec.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.72.0",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "esbuild": "0.28.2",
    "fx-runner": "1.7.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "nanoid": "3.3.20"
  }
}
